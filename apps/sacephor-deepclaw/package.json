{
	"name": "@sacephor/deepclaw",
	"version": "0.0.4",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=21"
	},
    "bin": {
        "deepclaw": "./bin/cli.js"
    },
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rollup -c",
		"build:release": "node scripts/build-release.mjs",
		"lint": "eslint **/*.ts",
		"test": "vitest run",
		"web": "npx tsx src/main.ts",
		"tui": "npx tsx src/main.ts --tui"
	},
	"dependencies": {
		"@deepclaw/tui": "workspace:*",
        "meow": "14.1.0"
	}
}
